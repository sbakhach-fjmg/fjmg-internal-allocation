# Copy to .env and fill in. Never commit .env.
MARKETCHECK_API_KEY=
# Sign-in (required before exposing the app on the internet)
APP_PASSWORD=
APP_SECRET=
# Where the SQLite db and uploads live (Railway: the mounted volume, /data)
DATA_DIR=
# Optional tuning
MARKETCHECK_RATE_PER_SEC=5
MARKETCHECK_MAX_PER_RUN=12000
PRIOR_K=8
MIN_N_STORE=3
MIN_N_BEST=5
GROSS_OVERRIDE_PCT=0.75
GROSS_OVERRIDE_ABS=2000
MARKETCHECK_WORKERS=4
MIN_N_COHORT=5
